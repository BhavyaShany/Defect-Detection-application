# Copy to deploy.env (never commit it) and edit.

# EXACT TensorFlow version the model was trained with: see models/evaluation_report.json -> environment -> tensorflow
TENSORFLOW_VERSION=2.0.0

# Hostname Caddy should serve. With only an IP address use the sslip.io trick:
#   IP 203.0.113.10  ->  203-0-113-10.sslip.io   (gets a real HTTPS certificate, no domain purchase needed)
# For a local test without HTTPS use  :80
SITE_ADDRESS=203-0-113-10.sslip.io

# Optional: confidence below this goes to manual REVIEW (take it from models/evaluation_report.md)
CONFIDENCE_THRESHOLD=0.75
