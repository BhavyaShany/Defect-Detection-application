# Copy to ".env" and edit. Never commit ".env".

# ---- Database ----
# Default: SQLite file in ./data. For PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://USER:PASSWORD@localhost:5432/defect_inspection
DATABASE_URL=
# If the configured database is unreachable, fall back to SQLite? (false = fail loudly)
DB_FALLBACK_SQLITE=true

# ---- API / CORS ----
# Comma-separated list of browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Trained model ----
# Keras file (.keras/.h5) or TensorFlow SavedModel directory, relative to project root
MODEL_PATH=models/defect_model.keras
# labels.json written by ml/train_model.py (class names, pass classes, input mode)
MODEL_LABELS_PATH=models/labels.json
# Predictions below this confidence are flagged REVIEW instead of PASS/FAIL
CONFIDENCE_THRESHOLD=0.75
# Input check ("is this a casting photo?") statistics written by `python -m ml.fit_ood`
OOD_PATH=models/ood.npz
OOD_COLOR_CHECK=true

# ---- Uploads ----
MAX_UPLOAD_MB=100
MAX_CONCURRENT_INSPECTIONS=2

# ---- Preprocessing ----
# none | pca | icp   (icp requires REFERENCE_SCAN_PATH)
ALIGNMENT_MODE=pca
REFERENCE_SCAN_PATH=
